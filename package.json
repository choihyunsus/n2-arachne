{
  "name": "n2-arachne",
  "version": "5.0.0",
  "description": "Scoped code and document retrieval, context assembly and backups over the common Soul SQLite database.",
  "main": "dist/library.js",
  "types": "dist/library.d.ts",
  "bin": {
    "n2-arachne": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:documents": "node scripts/build-documents.cjs",
    "build:watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "npm run build && node --test tests/*.test.cjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^12.8.0",
    "ignore": "^7.0.14",
    "zod": "^4.6.7",
    "@types/better-sqlite3": "^7.6.13"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "sqlite-vec": "^0.1.9",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "mcp",
    "ai",
    "context",
    "code-indexing",
    "llm",
    "rag",
    "local-first",
    "typescript"
  ],
  "author": "N2",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/choihyunsus/n2-arachne.git"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist/",
    "config.default.js",
    "scripts/build-documents.cjs",
    "document-worker/Cargo.toml",
    "document-worker/Cargo.lock",
    "document-worker/rust-toolchain.toml",
    "document-worker/src/",
    "document-worker/LICENSE",
    "bin/n2-arachne-doc-*",
    "THIRD-PARTY-NOTICES",
    "LICENSES/",
    "LICENSE",
    "LICENSE-APACHE",
    "README.md",
    "README.ko.md",
    "README.ja.md",
    "CHANGELOG.md"
  ]
}
